# Blueprint AI - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com suas chaves reais.

# Google Gemini API Key (obrigatório)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Alternativa: mesmo valor de VITE_GEMINI_API_KEY (usado como fallback)
VITE_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (opcional - necessário para usar OpenRouter)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (opcional - necessário para usar OpenAI)
VITE_OPENAI_API_KEY=your_openai_api_key_here
